---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="404 // Evidencia No Localizada">
  <Navbar activePath="" statusText="[CRITICAL_ERROR: 0x404_PAGE_CORRUPTED]" />

  <div class="min-h-[70vh] flex flex-col items-center justify-center py-12">
    <!-- Ventana de Error Estilo Windows 95 / CRT -->
    <div class="win95-container w-full max-w-2xl p-2 shadow-[8px_8px_0px_0px_#0A0A0A] border-2 border-[var(--negro)]">
      <!-- Titlebar Win95 Rojo -->
      <div class="bg-[var(--rojo)] text-white px-3 py-1.5 flex justify-between items-center font-mono-tech text-xs font-bold select-none">
        <span class="flex items-center gap-2">
          <span>⚠️</span>
          <span>SYS_CRASH // 0x404_FILE_NOT_FOUND.EXE</span>
        </span>
        <span class="text-[10px] bg-black px-1.5 py-0.5 border border-white font-mono-tech">FATAL_ERROR</span>
      </div>

      <!-- Contenido Interior -->
      <div class="p-6 bg-[#D4D0C8] border border-[#808080] border-t-white border-l-white space-y-6">
        <div class="flex flex-col sm:flex-row items-start gap-4">
          <!-- Icono de Error Crítico -->
          <div class="w-16 h-16 bg-[var(--rojo)] text-white font-display text-4xl flex items-center justify-center flex-shrink-0 border-2 border-[var(--negro)] shadow-[3px_3px_0px_0px_#0A0A0A]">
            ✕
          </div>
          
          <div class="space-y-2">
            <h1 class="font-display text-3xl sm:text-5xl uppercase tracking-tighter text-[var(--negro)] leading-none">
              404 // Registro Corrompido
            </h1>
            <p class="font-mono-tech text-xs text-[var(--rojo)] font-bold uppercase tracking-wider">
              ERROR: SECTOR_UNMAPPED_OR_LOST_IN_TRANSMISSION
            </p>
            <p class="font-mono-tech text-xs leading-relaxed text-[#222]">
              La coordenada o el fragmento de memoria solicitado no existe en el archivo central de Madrid o ha sido degradado irreversiblemente por el protocolo de tiempo.
            </p>
          </div>
        </div>

        <!-- Telemetría de Error Forense -->
        <div class="bg-[#0A0A0A] p-4 text-[var(--verde-acido)] font-mono-tech text-[11px] leading-relaxed border-2 border-[var(--negro)] space-y-1">
          <div>>> DIAGNÓSTICO: MEMORY_SEGMENTATION_FAULT</div>
          <div>>> NODO SOLICITADO: NO_MATCH_IN_CATALOG</div>
          <div>>> INTEGRIDAD DEL ARCHIVO: RESTO DE PIEZAS [001 - 008] OPERATIVAS</div>
          <div class="text-[#888] pt-1">>> RECOMENDACIÓN: REGRESAR A NODO SEGURO O REINICIAR RUTA EN CONSOLA CRT.</div>
        </div>

        <!-- Opciones de Navegación de Emergencia -->
        <div class="pt-2 flex flex-wrap justify-between items-center gap-3 border-t border-[#AAA] font-mono-tech">
          <span class="text-[10px] text-[#666]">YUX // RMB RECOVERY PROTOCOL</span>
          
          <div class="flex flex-wrap gap-2">
            <a href="/" class="win95-btn font-bold text-xs">
              [ ← NODO PRINCIPAL / ]
            </a>
            <a href="/archivo" class="win95-btn font-bold text-xs text-[var(--negro)]">
              [ 🗂️ VER CATÁLOGO ]
            </a>
            <a href="/terminal" class="win95-btn font-bold text-xs text-[var(--rojo)]">
              [ 💻 ABRIR TERMINAL ]
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
