---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';

export async function getStaticPaths() {
  const piezas = await getCollection('piezas');
  piezas.sort((a, b) => a.data.code.localeCompare(b.data.code));

  return piezas.map((pieza, index) => {
    const prevPiece = index > 0 ? piezas[index - 1] : null;
    const nextPiece = index < piezas.length - 1 ? piezas[index + 1] : null;

    return {
      params: { code: pieza.data.code },
      props: { pieza, prevPiece, nextPiece },
    };
  });
}

const { pieza, prevPiece, nextPiece } = Astro.props;
const { data } = pieza;

const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/*.{jpeg,jpg,png,gif}');
const imagePath = `../../assets/${data.image}`;
let resolvedImage: any = null;
if (images[imagePath]) {
  resolvedImage = await images[imagePath]();
}
---

<Layout title={data.title}>
  <Navbar activePath="/archivo" statusText={`[EXPEDIENTE #${data.code} // STATUS: ${data.status}]`} />

  <!-- Titular en móvil -->
  <div class="block lg:hidden mb-6">
    <h1 class="font-display text-4xl sm:text-5xl tracking-tighter uppercase leading-none" style={`color: ${data.accent_color};`}>
      {data.title}
    </h1>
  </div>

  <div class="detail-container mx-auto grid grid-cols-1 lg:grid-cols-12 gap-6 items-start" style={`--detail-accent: ${data.accent_color};`}>
    
    <!-- Columna 1: Titular Monumental Rotado 90° (Brutalismo) -->
    <div class="hidden lg:flex lg:col-span-2 justify-center items-start border-r-2 border-[var(--negro)] pr-4 min-h-[650px]">
      <h1 
        class="font-display text-7xl tracking-tighter uppercase select-none"
        style="writing-mode: vertical-rl; transform: rotate(180deg); color: var(--detail-accent);"
      >
        {data.title}
      </h1>
    </div>

    <!-- Columna 2: Media principal a tamaño completo -->
    <div class="lg:col-span-6 border-2 border-[var(--negro)] bg-[var(--concreto)] relative overflow-hidden">
      <div class="absolute top-2 left-2 z-10 bg-[var(--negro)] text-[var(--hueso)] font-mono-tech text-xs px-2 py-1 select-none">
        CATÁLOGO: YUX-RMB / #{data.code}
      </div>

      {data.media_type === 'video' ? (
        <video 
          src={`/assets/${data.image}`} 
          autoplay loop muted playsinline 
          class="w-full h-auto object-cover filter contrast-110 block"
        />
      ) : resolvedImage ? (
        <Image 
          src={resolvedImage.default} 
          alt={data.title} 
          width={1300}
          quality={90}
          class="w-full h-auto object-cover filter contrast-110 block" 
        />
      ) : (
        <img 
          src={`/assets/${data.image}`} 
          alt={data.title} 
          class="w-full h-auto object-cover filter contrast-110 block"
        />
      )}
    </div>

    <!-- Columna 3: Ventana de Error Win95 + Ficha Técnica Completa (Retrofuturismo) -->
    <div class="lg:col-span-4 flex flex-col gap-6">
      
      <!-- Ventana flotante/biselada Win95 -->
      <div class="win95-box p-1 shadow-[4px_4px_0px_0px_#0A0A0A]">
        <div class="win95-titlebar mb-3">
          <span class="text-xs font-mono-tech">SYS_DIALOG // {data.code}.EXE</span>
          <button 
            class="bg-[#C0C0C0] text-[var(--negro)] px-1.5 py-0 text-xs font-bold leading-none border border-white border-r-black border-bottom-black cursor-pointer active:translate-y-0.5"
            onclick="this.closest('.win95-box').style.display='none'"
            title="Cerrar diálogo"
          >×</button>
        </div>
        <div class="p-3 bg-[#C0C0C0]">
          <p class="font-mono-tech text-xs font-bold text-[#C41E1E] uppercase mb-2">
            {data.error_message}
          </p>
          <p class="text-xs font-body-manifesto text-[var(--negro)] mb-4 leading-relaxed">
            {data.manifest_text}
          </p>
          <div class="flex justify-end gap-2">
            <button 
              class="win95-btn" 
              onclick="window.location.reload()"
            >
              REINTENTAR
            </button>
            <a href="/archivo" class="win95-btn text-center inline-block">ABORTAR</a>
          </div>
        </div>
      </div>

      <!-- Bloque de Ficha Técnica Pura -->
      <div class="border-2 border-[var(--negro)] p-4 bg-[var(--hueso)] font-mono-tech text-xs shadow-[4px_4px_0px_0px_#0A0A0A]">
        <div class="border-b border-[var(--negro)] pb-2 mb-3 flex justify-between font-bold">
          <span>FICHA TÉCNICA</span>
          <span>{data.grid_version}</span>
        </div>
        <p class="mb-1.5"><span class="text-[#666]">SUJETO:</span> <span class="text-[var(--negro)] font-bold">{data.subject}</span></p>
        <p class="mb-1.5"><span class="text-[#666]">GPS:</span> <span class="text-[var(--negro)]">{data.coords}</span></p>
        {data.date_captured && (
          <p class="mb-1.5"><span class="text-[#666]">REGISTRO:</span> <span class="text-[var(--negro)]">{data.date_captured}</span></p>
        )}
        <p class="mb-3">
          <span class="text-[#666]">ACENTO:</span> 
          <span class="inline-block w-3 h-3 align-middle border border-black ml-1 mr-1" style={`background-color: ${data.accent_color};`}></span> 
          <span class="font-bold uppercase" style={`color: ${data.accent_color};`}>{data.accent_color}</span>
        </p>
        
        <!-- Navegación entre piezas correlativas -->
        <div class="border-t-2 border-[var(--negro)] pt-3 mt-4 flex justify-between uppercase font-bold text-xs">
          {prevPiece ? (
            <a href={`/archivo/${prevPiece.data.code}`} class="hover:underline hover:text-[var(--rojo)] transition-colors duration-75">
              ← #{prevPiece.data.code} ANTERIOR
            </a>
          ) : (
            <span class="text-[#888]">← ANTERIOR</span>
          )}

          {nextPiece ? (
            <a href={`/archivo/${nextPiece.data.code}`} class="hover:underline hover:text-[var(--rojo)] transition-colors duration-75">
              SIGUIENTE #{nextPiece.data.code} →
            </a>
          ) : (
            <span class="text-[#888]">SIGUIENTE →</span>
          )}
        </div>
      </div>

    </div>
  </div>
</Layout>
