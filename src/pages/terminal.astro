---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import SystemTerminal from '../components/SystemTerminal.astro';

const piezas = await getCollection('piezas');
piezas.sort((a, b) => a.data.code.localeCompare(b.data.code));
---

<Layout title="Terminal de Diagnóstico // Consola CRT">
  <Navbar activePath="/terminal" statusText="[CONSOLA TTY: CONECTADA]" />

  <div class="mb-6 border-b-2 border-[var(--negro)] pb-4 flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
      <div class="font-mono-tech text-xs uppercase text-[var(--rojo)] font-bold mb-1">
        SYS_MODULE // TTY CRT 80x24
      </div>
      <h1 class="font-display text-4xl md:text-6xl uppercase tracking-tighter leading-none text-[var(--negro)]">
        Terminal Forense
      </h1>
    </div>
    <div class="font-mono-tech text-xs text-[#555] max-w-md">
      Interfaz de línea de comandos para inspección directa de la base de memoria. Audio síntesis Model M activa.
    </div>
  </div>

  <SystemTerminal pieces={piezas} />

  <div class="mt-4 flex flex-wrap justify-between items-center text-xs font-mono-tech text-[#666] border-t border-[var(--concreto)] pt-3">
    <span>CONEXIÓN DIRECTA: 9600 BAUD // PARIDAD: NINGUNA</span>
    <span class="text-[var(--rojo)] font-bold">TIP: ESCRIBA "QUERY 001" O "STATUS"</span>
  </div>
</Layout>
