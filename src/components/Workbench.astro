    </div>
  </div>
</div>

<script>
  // HASH SHA-256 de la contraseña "Adrijosu1213*."
  const AUTH_HASH = "08321f3ec31545ae9af10c4f8deb49edd6cd5870927ab7740139015a814a179f";
  const STORAGE_KEY = "yux_workbench_authenticated_session";

  async function computeSha256(str: string): Promise<string> {
    const encoder = new TextEncoder();
    const data = encoder.encode(str);
    const hashBuffer = await crypto.subtle.digest("SHA-256", data);
    const hashArray = Array.from(new Uint8Array(hashBuffer));
    return hashArray.map(b => b.toString(16).padStart(2, "0")).join("");
  }

  function initWorkbenchSecurity() {
    const authScreen = document.getElementById("workbench-auth-screen");
    const mainContent = document.getElementById("workbench-main-content");
    const authForm = document.getElementById("auth-form") as HTMLFormElement;
    const passwordInput = document.getElementById("auth-password") as HTMLInputElement;
    const authError = document.getElementById("auth-error");
    const btnLogout = document.getElementById("btn-logout");

    // Verificar si ya existe sesión válida
    const savedHash = sessionStorage.getItem(STORAGE_KEY);
    if (savedHash === AUTH_HASH) {
      unlockWorkbench();
    }

    function unlockWorkbench() {
      authScreen?.classList.add("hidden");
      mainContent?.classList.remove("hidden");
    }

    function lockWorkbench() {
      sessionStorage.removeItem(STORAGE_KEY);
      mainContent?.classList.add("hidden");
      authScreen?.classList.remove("hidden");
      if (passwordInput) passwordInput.value = "";
      authError?.classList.add("hidden");
    }

    authForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const enteredPassword = passwordInput.value;
      const computed = await computeSha256(enteredPassword);

      if (computed === AUTH_HASH) {
        sessionStorage.setItem(STORAGE_KEY, AUTH_HASH);
        authError?.classList.add("hidden");
        unlockWorkbench();
      } else {
        authError?.classList.remove("hidden");
        passwordInput.value = "";
        passwordInput.focus();
      }
    });

    btnLogout?.addEventListener("click", () => {
      lockWorkbench();
    });

    // Pestañas
    const tabBtnEditor = document.getElementById("tab-btn-editor");
    const tabBtnFiles = document.getElementById("tab-btn-files");
    const tabBtnCatalog = document.getElementById("tab-btn-catalog");
    const tabBtnWaitlist = document.getElementById("tab-btn-waitlist");

    const tabContentEditor = document.getElementById("tab-content-editor");
    const tabContentFiles = document.getElementById("tab-content-files");
    const tabContentCatalog = document.getElementById("tab-content-catalog");
    const tabContentWaitlist = document.getElementById("tab-content-waitlist");

    function setActiveTab(tab: "editor" | "files" | "catalog" | "waitlist") {
      // Buttons
      tabBtnEditor?.classList.toggle("bg-[var(--negro)]", tab === "editor");
      tabBtnEditor?.classList.toggle("text-[var(--hueso)]", tab === "editor");
      tabBtnEditor?.classList.toggle("bg-[var(--hueso)]", tab !== "editor");
      tabBtnEditor?.classList.toggle("text-[var(--negro)]", tab !== "editor");

      tabBtnFiles?.classList.toggle("bg-[var(--negro)]", tab === "files");
      tabBtnFiles?.classList.toggle("text-[var(--hueso)]", tab === "files");
      tabBtnFiles?.classList.toggle("bg-[var(--hueso)]", tab !== "files");
      tabBtnFiles?.classList.toggle("text-[var(--negro)]", tab !== "files");

      tabBtnCatalog?.classList.toggle("bg-[var(--negro)]", tab === "catalog");
      tabBtnCatalog?.classList.toggle("text-[var(--hueso)]", tab === "catalog");
      tabBtnCatalog?.classList.toggle("bg-[var(--hueso)]", tab !== "catalog");
      tabBtnCatalog?.classList.toggle("text-[var(--negro)]", tab !== "catalog");

      tabBtnWaitlist?.classList.toggle("bg-[var(--negro)]", tab === "waitlist");
      tabBtnWaitlist?.classList.toggle("text-[var(--hueso)]", tab === "waitlist");
      tabBtnWaitlist?.classList.toggle("bg-[var(--hueso)]", tab !== "waitlist");
      tabBtnWaitlist?.classList.toggle("text-[var(--negro)]", tab !== "waitlist");

      // Contents
      tabContentEditor?.classList.toggle("hidden", tab !== "editor");
      tabContentFiles?.classList.toggle("hidden", tab !== "files");
      tabContentCatalog?.classList.toggle("hidden", tab !== "catalog");
      tabContentWaitlist?.classList.toggle("hidden", tab !== "waitlist");

      if (tab === "waitlist") {
        renderLocalSubscribers();
      }
    }

    tabBtnEditor?.addEventListener("click", () => setActiveTab("editor"));
    tabBtnFiles?.addEventListener("click", () => setActiveTab("files"));
    tabBtnCatalog?.addEventListener("click", () => setActiveTab("catalog"));
    tabBtnWaitlist?.addEventListener("click", () => setActiveTab("waitlist"));

    // Lógica de Google Sheets Webhook y Lista Local
    const webhookInput = document.getElementById("sheets-webhook-input") as HTMLInputElement;
    const btnSaveWebhook = document.getElementById("btn-save-webhook");
    const btnTestWebhook = document.getElementById("btn-test-webhook");
    const webhookToast = document.getElementById("webhook-toast");
    const btnExportCsv = document.getElementById("btn-export-csv");
    const subscribersList = document.getElementById("local-subscribers-list");
    const subscribersCountLabel = document.getElementById("subscribers-count-label");

    const WEBHOOK_KEY = "yux_google_sheets_webhook";
    const SUBSCRIBERS_KEY = "yux_rmb_waitlist_subscribers";

    // Cargar webhook guardado
    if (webhookInput) {
      webhookInput.value = localStorage.getItem(WEBHOOK_KEY) || "";
    }

    btnSaveWebhook?.addEventListener("click", () => {
      const url = webhookInput?.value?.trim() || "";
      localStorage.setItem(WEBHOOK_KEY, url);
      if (webhookToast) {
        webhookToast.textContent = url ? ">> CONEXIÓN GUARDADA // TERMINAL VINCULADA" : ">> URL ELIMINADA // MODO LOCAL ACTIVO";
        webhookToast.classList.remove("hidden");
        setTimeout(() => webhookToast.classList.add("hidden"), 3000);
      }
    });

    btnTestWebhook?.addEventListener("click", async () => {
      const url = webhookInput?.value?.trim();
      if (!url) {
        alert("Por favor ingrese primero la URL de Google Apps Script.");
        return;
      }
      try {
        if (btnTestWebhook) btnTestWebhook.textContent = "[ TRANSMITIENDO TEST... ]";
        await fetch(url, {
          method: "POST",
          mode: "no-cors",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email: "test.terminal@yux-rmb.com",
            timestamp: new Date().toISOString(),
            nodo: "TEST_CONEXION_WORKBENCH",
            batch: "VERIFICACION"
          })
        });
        if (webhookToast) {
          webhookToast.textContent = ">> TRANSMISIÓN ENVIADA A GOOGLE SHEETS // REVISA TU HOJA";
          webhookToast.classList.remove("hidden");
          setTimeout(() => webhookToast.classList.add("hidden"), 4000);
        }
      } catch (err: any) {
        alert("Error al contactar con la URL: " + err.message);
      } finally {
        if (btnTestWebhook) btnTestWebhook.textContent = "[ ENVIAR TRANSMISIÓN DE PRUEBA ]";
      }
    });

    function renderLocalSubscribers() {
      const subs = JSON.parse(localStorage.getItem(SUBSCRIBERS_KEY) || "[]");
      if (subscribersCountLabel) {
        subscribersCountLabel.textContent = `REGISTROS CAPTURADOS (${subs.length})`;
      }
      if (subscribersList) {
        if (subs.length === 0) {
          subscribersList.innerHTML = `<div class="text-[#888] italic py-2">No hay registros locales aún. Los correos ingresados en /suministros se listarán aquí.</div>`;
        } else {
          subscribersList.innerHTML = subs.map((s: any, idx: number) => `
            <div class="flex justify-between items-center py-1 border-b border-[#eee]">
              <span class="font-bold">#${(idx + 1).toString().padStart(2, "0")} ${typeof s === "string" ? s : s.email}</span>
              <span class="text-[9px] text-[#888]">${typeof s === "object" && s.timestamp ? s.timestamp.substring(0, 10) : "RECIENTE"}</span>
            </div>
          `).reverse().join("");
        }
      }

      // Renderizar solicitudes de logo vectorial recibidas en /assets
      const logoReqs = JSON.parse(localStorage.getItem('yux_rmb_logo_requests') || '[]');
      const logoCountLabel = document.getElementById('logo-requests-count-label');
      const logoList = document.getElementById('local-logo-requests-list');
      if (logoCountLabel) {
        logoCountLabel.textContent = `SOLICITUDES DE LOGO .SVG (${logoReqs.length})`;
      }
      if (logoList) {
        if (logoReqs.length === 0) {
          logoList.innerHTML = `<div class="text-[#888] italic py-2">No hay solicitudes de logotipo aún. Los pedidos recibidos en /assets se registrarán aquí con su justificación.</div>`;
        } else {
          logoList.innerHTML = logoReqs.map((r: any, idx: number) => `
            <div class="p-2 border border-[#ddd] bg-[#fdfdfd] space-y-1">
              <div class="flex justify-between items-center text-[10px]">
                <span class="font-bold text-[var(--rojo)]">#${(idx + 1).toString().padStart(2, '0')} ${r.email}</span>
                <span class="text-[#888]">${r.timestamp ? r.timestamp.substring(0, 10) : 'RECIENTE'}</span>
              </div>
              <div class="text-[10px] text-[#444]">
                <b>SOLICITANTE:</b> ${r.name || 'NO ESPECIFICADO'}
              </div>
              <div class="text-[10px] bg-[#eee] p-1.5 border-l-2 border-[var(--rojo)] leading-tight text-[#222]">
                <b>MOTIVO:</b> "${r.reason}"
              </div>
              <div class="pt-1 flex justify-end">
                <a href="mailto:${r.email}?subject=YUX%20//%20Isotipo%20Vectorial%20Oficial&body=Hola%20${encodeURIComponent(r.name || '')},%0A%0AEn%20relaci%C3%B3n%20a%20tu%20solicitud%20del%20logotipo%20vectorial%20de%20YUX%20RMB%20para:%0A%22${encodeURIComponent(r.reason || '')}%22,%0A%0AAdjunto%20te%20remito%20el%20archivo%20vectorial%20maestro%20.SVG.%0A%0ASaludos,%0AJosuhe%20//%20YUX%20RMB" class="win95-btn text-[9px] font-bold">
                  [ ENVIAR LOGO VÍA EMAIL ]
                </a>
              </div>
            </div>
          `).reverse().join('');
        }
      }
    }

    btnExportCsv?.addEventListener("click", () => {
      const subs = JSON.parse(localStorage.getItem(SUBSCRIBERS_KEY) || "[]");
      if (subs.length === 0) {
        alert("No hay registros para exportar.");
        return;
      }
      let csv = "FECHA,EMAIL,NODO,BATCH\n";
      subs.forEach((s: any) => {
        const email = typeof s === "string" ? s : s.email;
        const date = typeof s === "object" && s.timestamp ? s.timestamp : new Date().toISOString();
        csv += `"${date}","${email}","MADRID_CENTRO","BATCH_01"\n`;
      });
      downloadFile(csv, `YUX_WAITLIST_${new Date().toISOString().substring(0, 10)}.csv`, "text/csv");
    });

    document.getElementById("btn-export-logo-requests-csv")?.addEventListener("click", () => {
      const reqs = JSON.parse(localStorage.getItem("yux_rmb_logo_requests") || "[]");
      if (reqs.length === 0) {
        alert("No hay solicitudes de logotipo para exportar.");
        return;
      }
      let csv = "FECHA,EMAIL,SOLICITANTE,MOTIVO\n";
      reqs.forEach((r: any) => {
        csv += `"${r.timestamp || ''}","${r.email || ''}","${(r.name || '').replace(/"/g, '""')}","${(r.reason || '').replace(/"/g, '""')}"\n`;
      });
      downloadFile(csv, `YUX_SOLICITUDES_LOGO_${new Date().toISOString().substring(0, 10)}.csv`, "text/csv");
    });

    // Subida y manejo de imagen en local
    const imageInput = document.getElementById("image-file-input") as HTMLInputElement;
    const fileInfoBadge = document.getElementById("file-info-badge");
    const previewUploadedImg = document.getElementById("preview-uploaded-image") as HTMLImageElement;
    const previewFallbackText = document.getElementById("preview-fallback-text");
    const btnBundleImg = document.getElementById("btn-bundle-img") as HTMLButtonElement;
    let selectedImageBlob: Blob | null = null;

    imageInput?.addEventListener("change", (e: any) => {
      const file = e.target.files?.[0];
      if (file) {
        selectedImageBlob = file;
        if (fileInfoBadge) fileInfoBadge.textContent = `${file.name} (${(file.size / 1024).toFixed(1)} KB)`;
        const reader = new FileReader();
        reader.onload = (re) => {
          if (previewUploadedImg && re.target?.result) {
            previewUploadedImg.src = re.target.result as string;
            previewUploadedImg.classList.remove("hidden");
            previewFallbackText?.classList.add("hidden");
          }
        };
        reader.readAsDataURL(file);
        if (btnBundleImg) btnBundleImg.disabled = false;
      }
    });

    // Form logic & live updates
    const codeEl = document.getElementById('field-code') as HTMLInputElement;
    const titleEl = document.getElementById('field-title') as HTMLInputElement;
    const subjectEl = document.getElementById('field-subject') as HTMLInputElement;
    const dateEl = document.getElementById('field-date') as HTMLInputElement;
    const coordsEl = document.getElementById('field-coords') as HTMLInputElement;
    const latEl = document.getElementById('field-lat') as HTMLInputElement;
    const lngEl = document.getElementById('field-lng') as HTMLInputElement;
    const errorEl = document.getElementById('field-error') as HTMLInputElement;
    const manifestEl = document.getElementById('field-manifest') as HTMLTextAreaElement;
    const accentEl = document.getElementById('field-accent') as HTMLInputElement;
    const accentPicker = document.getElementById('field-accent-picker') as HTMLInputElement;
    const mediaTypeEl = document.getElementById('field-media-type') as HTMLSelectElement;
    const statusEl = document.getElementById('field-status') as HTMLSelectElement;

    const previewCard = document.getElementById('preview-card');
    const previewCodeBadge = document.getElementById('preview-card-code-badge');
    const previewStatusBadge = document.getElementById('preview-card-status-badge');
    const previewTitle = document.getElementById('preview-card-title');
    const previewSubject = document.getElementById('preview-card-subject');
    const previewCoords = document.getElementById('preview-card-coords');
    const previewError = document.getElementById('preview-card-error');
    const previewText = document.getElementById('preview-card-text');
    const previewMediaLabel = document.getElementById('preview-card-media-label');

    const outputMd = document.getElementById('output-markdown');
    const outputCaption = document.getElementById('output-caption');
    const mdFilenameLabel = document.getElementById('md-filename-label');
    const downloadMdLabel = document.getElementById('download-md-label');
    const downloadImgLabel = document.getElementById('download-img-label');

    function update() {
      const code = (codeEl?.value || '009').padStart(3, '0');
      const title = titleEl?.value || 'TITULO // ERROR';
      const subject = subjectEl?.value || 'Sujeto, Madrid';
      const date = dateEl?.value || '';
      const coords = coordsEl?.value || '40°00\'00"N 3°00\'00"O';
      const lat = parseFloat(latEl?.value || '0');
      const lng = parseFloat(lngEl?.value || '0');
      const error = errorEl?.value || 'SYS_ERROR: UNKNOWN';
      const manifest = manifestEl?.value || '';
      const accent = accentEl?.value || '#C41E1E';
      const mediaType = mediaTypeEl?.value || 'image';
      const status = statusEl?.value || 'CORRUPTED';

      if (previewCard) previewCard.style.setProperty('--card-accent', accent);
      if (previewCodeBadge) previewCodeBadge.textContent = `#${code}`;
      if (previewStatusBadge) {
        previewStatusBadge.textContent = `[${status}]`;
        previewStatusBadge.style.color = accent;
      }
      if (previewTitle) previewTitle.textContent = title;
      if (previewSubject) previewSubject.textContent = subject;
      if (previewCoords) previewCoords.textContent = coords;
      if (previewError) {
        previewError.textContent = error;
        previewError.style.color = accent;
      }
      if (previewText) previewText.textContent = manifest;
      if (previewMediaLabel) previewMediaLabel.textContent = `${code}.${mediaType === 'video' ? 'mp4' : 'jpg'}`;

      if (mdFilenameLabel) mdFilenameLabel.textContent = `GENERADOR_OUTPUT // ${code}.MD`;
      if (downloadMdLabel) downloadMdLabel.textContent = `${code}.md`;
      if (downloadImgLabel) downloadImgLabel.textContent = `${code}.jpg`;

      const mdContent = `---
code: "${code}"
title: "${title}"
subject: "${subject}"
coords: "${coords.replace(/"/g, '\\"')}"
lat: ${lat}
lng: ${lng}
${date ? `date_captured: "${date}"\n` : ''}error_message: "${error}"
manifest_text: "${manifest.replace(/"/g, '\\"')}"
grid_version: "RMB-V1.2"
image: "${code}.${mediaType === 'video' ? 'mp4' : 'jpg'}"
media_type: "${mediaType}"
accent_color: "${accent}"
status: "${status}"
---`;

      if (outputMd) outputMd.textContent = mdContent;

      const captionContent = `YUX

${manifest}

${error}
YUX-RMB / #${code} / ${coords} / GRID: RMB-V1.2

#retromaximalismobruto #diseñográfico #brutalism #retrofuturismo #maximalism #collageart #glitchart #madrid`;

      if (outputCaption) outputCaption.textContent = captionContent;
    }

    accentPicker?.addEventListener('input', () => {
      if (accentEl) accentEl.value = accentPicker.value.toUpperCase();
      update();
    });

    accentEl?.addEventListener('input', () => {
      if (accentPicker && /^#[0-9A-F]{6}$/i.test(accentEl.value)) {
        accentPicker.value = accentEl.value;
      }
      update();
    });

    [codeEl, titleEl, subjectEl, dateEl, coordsEl, latEl, lngEl, errorEl, manifestEl, mediaTypeEl, statusEl].forEach(inp => {
      inp?.addEventListener('input', update);
    });

    // Copy text
    document.getElementById('btn-copy-md')?.addEventListener('click', () => {
      if (outputMd?.textContent) {
        navigator.clipboard.writeText(outputMd.textContent).then(() => {
          const toast = document.getElementById('md-copied-toast');
          if (toast) {
            toast.style.opacity = '1';
            setTimeout(() => { toast.style.opacity = '0'; }, 2000);
          }
        });
      }
    });

    document.getElementById('btn-copy-caption')?.addEventListener('click', () => {
      if (outputCaption?.textContent) {
        navigator.clipboard.writeText(outputCaption.textContent).then(() => {
          const toast = document.getElementById('caption-copied-toast');
          if (toast) {
            toast.style.opacity = '1';
            setTimeout(() => { toast.style.opacity = '0'; }, 2000);
          }
        });
      }
    });

    // Descarga de archivos directos
    function downloadFile(content: string | Blob, filename: string, type = "text/plain;charset=utf-8") {
      const blob = typeof content === "string" ? new Blob([content], { type }) : content;
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    document.getElementById('btn-download-md')?.addEventListener('click', () => {
      const code = (codeEl?.value || '009').padStart(3, '0');
      if (outputMd?.textContent) {
        downloadFile(outputMd.textContent, `${code}.md`);
      }
    });

    document.getElementById('btn-bundle-md')?.addEventListener('click', () => {
      const code = (codeEl?.value || '009').padStart(3, '0');
      if (outputMd?.textContent) {
        downloadFile(outputMd.textContent, `${code}.md`);
      }
    });

    btnBundleImg?.addEventListener('click', () => {
      const code = (codeEl?.value || '009').padStart(3, '0');
      if (selectedImageBlob) {
        downloadFile(selectedImageBlob, `${code}.jpg`, "image/jpeg");
      }
    });

    // Cargar pieza existente en el editor
    document.querySelectorAll('.btn-load-piece').forEach((btn) => {
      btn.addEventListener('click', (e: any) => {
        const data = JSON.parse(e.currentTarget.getAttribute('data-piece'));
        if (data) {
          if (codeEl) codeEl.value = data.code;
          if (titleEl) titleEl.value = data.title;
          if (subjectEl) subjectEl.value = data.subject;
          if (dateEl) dateEl.value = data.date_captured || '';
          if (coordsEl) coordsEl.value = data.coords;
          if (latEl) latEl.value = data.lat || '';
          if (lngEl) lngEl.value = data.lng || '';
          if (errorEl) errorEl.value = data.error_message;
          if (manifestEl) manifestEl.value = data.manifest_text;
          if (accentEl) accentEl.value = data.accent_color;
          if (accentPicker) accentPicker.value = data.accent_color;
          if (mediaTypeEl) mediaTypeEl.value = data.media_type || 'image';
          if (statusEl) statusEl.value = data.status || 'CORRUPTED';
          update();
          setActiveTab('editor');
        }
      });
    });

    update();
  }

  initWorkbenchSecurity();
  document.addEventListener('astro:page-load', initWorkbenchSecurity);
</script>
