              <div class="border-b border-[var(--negro)] pb-2 mb-3 flex justify-between items-center font-bold">
                <span id="logo-requests-count-label" class="text-[var(--rojo)] font-bold">SOLICITUDES DE LOGO .SVG (0)</span>
                <button id="btn-export-logo-requests-csv" class="win95-btn text-[10px] font-bold text-[var(--rojo)]">
                  [ EXPORTAR CSV SOLICITUDES ]
                </button>
              </div>

              <div id="local-logo-requests-list" class="max-h-56 overflow-y-auto space-y-2 text-[11px] text-[#333]">
                <!-- Lista inyectada por JS -->
