            </div>

            <!-- Terminales Registradas Localmente -->
            <div class="border-2 border-[var(--negro)] p-4 bg-white font-mono-tech text-xs">
              <div class="border-b border-[var(--negro)] pb-2 mb-3 flex justify-between items-center font-bold">
                <span id="subscribers-count-label">REGISTROS CAPTURADOS (0)</span>
                <button id="btn-export-csv" class="win95-btn text-[10px] font-bold">
