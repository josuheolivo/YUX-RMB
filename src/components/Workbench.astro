    <!-- PESTAÑA 04: LISTA PRIORITARIA & GOOGLE SHEETS -->
    <div id="tab-content-waitlist" class="hidden space-y-6">
      <div class="bg-[var(--hueso)] border-2 border-[var(--negro)] p-6 shadow-[4px_4px_0px_0px_#0A0A0A]">
        <div class="border-b-2 border-[var(--negro)] pb-3 mb-6 flex flex-wrap justify-between items-center gap-2">
          <div>
            <h3 class="font-display text-2xl uppercase tracking-tighter">SINCRONIZACIÓN CON GOOGLE SHEETS</h3>
            <p class="font-mono-tech text-xs text-[#555]">Conecta la terminal de /suministros directamente a tu hoja de cálculo para recibir los registros en tiempo real.</p>
          </div>
          <span class="font-mono-tech text-xs bg-[var(--verde-acido)] text-[var(--negro)] px-2 py-0.5 font-bold">100% GRATIS // SIN SERVIDOR</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <!-- Configuración de URL -->
          <div class="lg:col-span-7 space-y-4">
            <div class="win95-container p-4">
              <div class="win95-titlebar text-xs mb-3">
                <span>CONFIGURACIÓN // GOOGLE_APPS_SCRIPT_WEBHOOK</span>
              </div>
              
              <div class="font-mono-tech text-xs space-y-3">
                <label class="block font-bold text-[var(--negro)]">
