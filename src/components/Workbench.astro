---
interface Props {
  existingPieces?: Array<{
    data: {
      code: string;
      title: string;
      subject: string;
      coords: string;
      lat?: number;
      lng?: number;
      date_captured?: string;
      error_message: string;
      manifest_text: string;
      grid_version: string;
      image: string;
      media_type: string;
      accent_color: string;
      status: string;
    };
  }>;
}

const { existingPieces = [] } = Astro.props;
---

<div id="workbench-root" class="relative">
  <!-- 1. PANTALLA DE ACCESO PROTEGIDO (VISIBLE POR DEFECTO HASTA INGRESAR CONTRASEÑA) -->
  <div id="workbench-auth-screen" class="py-12 flex justify-center items-center">
    <div class="win95-container w-full max-w-md p-2 shadow-[6px_6px_0px_0px_#0A0A0A]">
      <div class="win95-titlebar text-xs mb-3 flex justify-between items-center">
        <span>SYS_SECURITY // WORKBENCH_LOCK.EXE</span>
        <span class="text-[9px] bg-[var(--rojo)] px-1.5 py-0.5 text-white font-bold">RESTRINGIDO</span>
      </div>

      <div class="p-4 bg-[#D4D0C8] border border-[#808080] border-t-white border-l-white">
        <div class="flex items-start gap-4 mb-4">
          <div class="w-10 h-10 bg-[#0A0A0A] text-[var(--rojo)] flex items-center justify-center font-bold text-xl border-2 border-white flex-shrink-0">
            !
          </div>
          <div>
            <h2 class="font-display text-lg tracking-tight text-[var(--negro)] leading-none mb-1">
              ACCESO AUTORIZADO EXCLUSIVO
            </h2>
            <p class="font-mono-tech text-[11px] text-[#333] leading-tight">
              Este workbench es de uso exclusivo de administración. Ingrese la clave de protocolo forense para desbloquear los controles del archivo.
            </p>
          </div>
        </div>

        <form id="auth-form" class="space-y-3 font-mono-tech text-xs">
          <div>
            <label for="auth-password" class="block font-bold text-[10px] text-[#444] uppercase mb-1">
              CLAVE DE PROTOCOLO:
            </label>
            <input 
              type="password" 
              id="auth-password"
              class="w-full bg-white border-2 border-[var(--negro)] p-2 font-mono-tech outline-none tracking-widest font-bold focus:border-[var(--rojo)]"
              placeholder="••••••••••••••"
              autocomplete="current-password"
              required
            />
          </div>

          <div id="auth-error" class="hidden p-2 bg-[#0A0A0A] text-[var(--rojo)] font-bold text-[10px] tracking-wide border border-[var(--rojo)]">
            >> ACCESO DENEGADO: CLAVE INCORRECTA // INTENTO REGISTRADO
          </div>

          <div class="flex justify-between items-center pt-2 border-t border-[#BBB]">
            <a href="/" class="win95-btn text-[10px]">
              ← CANCELAR
            </a>
            <button type="submit" class="win95-btn font-bold text-[11px] text-[var(--negro)]">
              [ DESBLOQUEAR WORKBENCH ]
            </button>
          </div>
        </form>
      </div>

      <div class="p-2 text-center text-[10px] font-mono-tech text-[#555]">
        SEGURIDAD CRIPTOGRÁFICA // SHA-256 HASH VERIFICATION
      </div>
    </div>
  </div>

  <!-- 2. PANEL DE TRABAJO WORKBENCH (DESBLOQUEADO TRAS AUTENTICACIÓN) -->
  <div id="workbench-main-content" class="hidden space-y-6">
    <!-- Barra Superior de Control de Sesión -->
    <div class="win95-container p-2 flex flex-wrap justify-between items-center gap-3 shadow-[3px_3px_0px_0px_#0A0A0A]">
      <div class="flex items-center gap-3 font-mono-tech text-xs">
        <span class="inline-block w-2.5 h-2.5 bg-[var(--verde-acido)] animate-pulse"></span>
        <span class="font-bold text-[var(--negro)]">SESIÓN AUTORIZADA // JOSUHE RMB</span>
        <span class="text-[#666] hidden sm:inline">| NÚCLEO: V2.0 PRODUCTION</span>
      </div>

      <div class="flex items-center gap-2">
        <a href="/admin" target="_blank" class="win95-btn text-[10px] font-bold">
          [ ABRIR PANEL DECAP CMS ↗ ]
        </a>
        <button id="btn-logout" class="win95-btn text-[10px] text-[var(--rojo)] font-bold">
          [ BLOQUEAR / SALIR ]
        </button>
      </div>
    </div>

    <!-- Navegación interna de pestañas -->
    <div class="flex border-b-2 border-[var(--negro)] bg-[var(--hueso)] font-mono-tech text-xs font-bold uppercase overflow-x-auto">
      <button id="tab-btn-editor" class="p-3 border-r-2 border-[var(--negro)] bg-[var(--negro)] text-[var(--hueso)] cursor-pointer">
        01. GENERADOR & PREVIEW
      </button>
      <button id="tab-btn-files" class="p-3 border-r-2 border-[var(--negro)] bg-[var(--hueso)] text-[var(--negro)] hover:bg-[var(--concreto)] cursor-pointer">
        02. GESTOR DE ARCHIVOS (.MD + .JPG)
      </button>
      <button id="tab-btn-catalog" class="p-3 border-r-2 border-[var(--negro)] bg-[var(--hueso)] text-[var(--negro)] hover:bg-[var(--concreto)] cursor-pointer">
        03. EXPEDIENTES ({existingPieces.length})
      </button>
      <button id="tab-btn-waitlist" class="p-3 bg-[var(--hueso)] text-[var(--negro)] hover:bg-[var(--concreto)] cursor-pointer">
        04. LISTA PRIORITARIA & GOOGLE SHEETS
      </button>
    </div>

    <!-- PESTAÑA 01: GENERADOR & PREVIEW -->
    <div id="tab-content-editor" class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Columna Formulario (7 cols) -->
      <div class="lg:col-span-7 bg-[var(--hueso)] border-2 border-[var(--negro)] p-5 sm:p-6 shadow-[4px_4px_0px_0px_#0A0A0A]">
        <div class="border-b-2 border-[var(--negro)] pb-3 mb-6 flex justify-between items-center">
          <h2 class="font-display text-2xl uppercase tracking-tighter">PARÁMETROS DE EXPEDIENTE</h2>
          <span class="font-mono-tech text-xs bg-[var(--negro)] text-[var(--hueso)] px-2 py-0.5 font-bold">RMB-V2.0</span>
        </div>

        <form id="workbench-form" class="space-y-4 font-mono-tech text-xs">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label class="block font-bold mb-1 uppercase text-[#555]">CÓDIGO (3 Dígitos)*</label>
              <input 
                type="text" 
                id="field-code" 
                value="009" 
                class="w-full bg-[var(--concreto)] bg-opacity-30 border border-[var(--negro)] p-2 font-mono-tech focus:bg-white outline-none"
                placeholder="009"
                required
              />
            </div>
            <div class="sm:col-span-2">
              <label class="block font-bold mb-1 uppercase text-[#555]">TÍTULO (SUJETO // FALLO)*</label>
              <input 
                type="text" 
                id="field-title" 
                value="TORRE // DESINC" 
                class="w-full bg-[var(--concreto)] bg-opacity-30 border border-[var(--negro)] p-2 font-mono-tech focus:bg-white outline-none font-bold"
                placeholder="TORRE // DESINC"
                required
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block font-bold mb-1 uppercase text-[#555]">SUJETO / EDIFICIO*</label>
              <input 
                type="text" 
                id="field-subject" 
                value="Torres de Colón, Madrid" 
                class="w-full bg-[var(--concreto)] bg-opacity-30 border border-[var(--negro)] p-2 font-mono-tech focus:bg-white outline-none"
                placeholder="Torres de Colón, Madrid"
                required
              />
            </div>
            <div>
              <label class="block font-bold mb-1 uppercase text-[#555]">FECHA CAPTURA (YYYY-MM-DD)</label>
              <input 
                type="text" 
                id="field-date" 
                value="2024-05-18" 
                class="w-full bg-[var(--concreto)] bg-opacity-30 border border-[var(--negro)] p-2 font-mono-tech focus:bg-white outline-none"
                placeholder="2024-05-18"
              />
            </div>
          </div>

          <div>
            <label class="block font-bold mb-1 uppercase text-[#555]">COORDENADAS GPS (FORMATO FORENSE)*</label>
            <input 
              type="text" 
              id="field-coords" 
              value="40°25'31.10\"N 3°41'27.50\"O (Plaza de Colón)" 
              class="w-full bg-[var(--concreto)] bg-opacity-30 border border-[var(--negro)] p-2 font-mono-tech focus:bg-white outline-none"
              placeholder="40°25'31.10\"N 3°41'27.50\"O"
              required
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block font-bold mb-1 uppercase text-[#555]">LATITUD MAPA (DECIMAL)</label>
              <input 
                type="number" 
                step="0.00001" 
                id="field-lat" 
                value="40.42530" 
                class="w-full bg-[var(--concreto)] bg-opacity-30 border border-[var(--negro)] p-2 font-mono-tech focus:bg-white outline-none"
                placeholder="40.42530"
              />
            </div>
            <div>
              <label class="block font-bold mb-1 uppercase text-[#555]">LONGITUD MAPA (DECIMAL)</label>
              <input 
                type="number" 
                step="0.00001" 
                id="field-lng" 
                value="-3.69090" 
                class="w-full bg-[var(--concreto)] bg-opacity-30 border border-[var(--negro)] p-2 font-mono-tech focus:bg-white outline-none"
                placeholder="-3.69090"
              />
            </div>
          </div>

          <div>
            <label class="block font-bold mb-1 uppercase text-[#555]">MENSAJE DE ERROR FORENSE*</label>
            <input 
              type="text" 
              id="field-error" 
              value="CRITICAL_FAULT: SUSPENSION_STRUCTURE_CORRUPTED" 
              class="w-full bg-[var(--concreto)] bg-opacity-30 border border-[var(--negro)] p-2 font-mono-tech focus:bg-white outline-none text-[var(--rojo)] font-bold"
              placeholder="SYS_ERROR: ..."
              required
            />
          </div>

          <div>
            <label class="block font-bold mb-1 uppercase text-[#555]">TEXTO / MANIFIESTO FORENSE*</label>
            <textarea 
              id="field-manifest" 
              rows="3" 
              class="w-full bg-[var(--concreto)] bg-opacity-30 border border-[var(--negro)] p-2 font-serif-manifesto focus:bg-white outline-none leading-relaxed text-sm"
              placeholder="El sistema intentó calcular el peso suspendido..."
              required
            >El sistema intentó calcular la tensión de los cables que sostienen el hormigón. La gravedad no entraba en el presupuesto original del monitoreo. El error no es la caída: es asumir que una estructura suspendida en el aire puede mantenerse quieta para siempre.</textarea>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label class="block font-bold mb-1 uppercase text-[#555]">ACENTO CROMÁTICO</label>
              <div class="flex items-center gap-2">
                <input 
                  type="color" 
                  id="field-accent-picker" 
                  value="#4DE8F4" 
                  class="w-8 h-8 border border-black p-0 cursor-pointer"
                />
                <input 
                  type="text" 
                  id="field-accent" 
                  value="#4DE8F4" 
                  class="flex-1 bg-[var(--concreto)] bg-opacity-30 border border-[var(--negro)] p-2 font-mono-tech uppercase font-bold"
                />
              </div>
            </div>
            <div>
              <label class="block font-bold mb-1 uppercase text-[#555]">TIPO MEDIO</label>
              <select id="field-media-type" class="w-full bg-[var(--concreto)] bg-opacity-30 border border-[var(--negro)] p-2 font-mono-tech">
                <option value="image">IMAGE (.JPG)</option>
                <option value="video">VIDEO (.MP4)</option>
              </select>
            </div>
            <div>
              <label class="block font-bold mb-1 uppercase text-[#555]">ESTADO NODO</label>
              <select id="field-status" class="w-full bg-[var(--concreto)] bg-opacity-30 border border-[var(--negro)] p-2 font-mono-tech">
                <option value="CORRUPTED">CORRUPTED</option>
                <option value="SYSTEM_FAIL">SYSTEM_FAIL</option>
                <option value="ARCHIVED">ARCHIVED</option>
              </select>
            </div>
          </div>
        </form>
      </div>

      <!-- Columna Live Preview y Exportación (5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        <!-- Live Preview Card -->
        <div class="border-2 border-[var(--negro)] bg-[var(--hueso)] p-4 shadow-[4px_4px_0px_0px_#0A0A0A]">
          <div class="font-mono-tech text-xs font-bold uppercase mb-3 flex justify-between items-center border-b border-[var(--negro)] pb-2">
            <span>PREVISUALIZADOR // RATIO 3:4</span>
            <span id="preview-status-badge" class="text-[var(--rojo)] text-[10px]">PREVIEW EN VIVO</span>
          </div>

          <div class="max-w-[320px] mx-auto">
            <article 
              id="preview-card" 
              class="card-rmb group flex flex-col bg-[var(--hueso)] border-2 border-[var(--negro)] relative overflow-hidden" 
              style="--card-accent: #4DE8F4;"
            >
              <div class="card-media relative aspect-[3/4] bg-[var(--concreto)] overflow-hidden border-b-2 border-[var(--negro)]">
                <span id="preview-card-code-badge" class="absolute top-2 left-2 z-10 bg-[var(--negro)] text-[var(--hueso)] font-mono-tech text-xs px-2 py-0.5">
                  #009
                </span>
                <span id="preview-card-status-badge" class="absolute top-2 right-2 z-10 bg-[var(--negro)] text-[var(--card-accent)] font-mono-tech text-[9px] px-1.5 py-0.5 font-bold border border-[#333]">
                  [CORRUPTED]
                </span>

                <!-- Imagen simulada o subida -->
                <div id="preview-media-container" class="w-full h-full flex flex-col items-center justify-center bg-[#151515] text-[var(--hueso)] p-4 text-center overflow-hidden">
                  <img id="preview-uploaded-image" class="hidden w-full h-full object-cover filter contrast-105" alt="Preview" />
                  <div id="preview-fallback-text" class="flex flex-col items-center">
                    <span class="font-mono-tech text-xs text-[#888] mb-1">[MEDIA CONTAINER]</span>
                    <span id="preview-card-media-label" class="font-mono-tech text-sm font-bold text-[var(--card-accent)]">009.jpg</span>
                    <div class="mt-3 text-[9px] font-mono-tech text-[#666] border border-[#333] p-1.5">
                      SUBE TU IMAGEN EN LA PESTAÑA 02
                    </div>
                  </div>
                </div>

                <!-- Overlay de Glitch cromático en Hover -->
                <div class="absolute inset-0 opacity-0 group-hover:opacity-30 pointer-events-none mix-blend-color-dodge transition-opacity duration-75" style="background-color: var(--card-accent);"></div>
              </div>

              <div class="p-4 flex-1 flex flex-col justify-between bg-[var(--hueso)]">
                <div>
                  <p id="preview-card-error" class="font-mono-tech text-xs uppercase mb-1 tracking-wider font-bold" style="color: var(--card-accent);">
                    CRITICAL_FAULT: SUSPENSION_STRUCTURE_CORRUPTED
                  </p>
                  <h3 id="preview-card-title" class="font-display text-2xl tracking-tighter leading-none mb-1 text-[var(--negro)]">
                    TORRE // DESINC
                  </h3>
                  <p id="preview-card-subject" class="text-xs italic text-[#444] mb-1">Torres de Colón, Madrid</p>
                  <p id="preview-card-coords" class="font-mono-tech text-[10px] text-[#555] mb-2">40°25'31.10"N 3°41'27.50"O</p>
                  <p id="preview-card-text" class="text-xs font-serif-manifesto leading-relaxed text-[#111] line-clamp-3 mb-3">
                    El sistema intentó calcular la tensión de los cables que sostienen el hormigón...
                  </p>
                </div>

                <div class="font-mono-tech text-[9px] text-[#888] border-t border-[#CCC] pt-2 flex justify-between">
                  <span>GRID: RMB-V1.2</span>
                  <span class="font-bold uppercase underline">[VER EVIDENCIA]</span>
                </div>
              </div>
            </article>
          </div>
        </div>

        <!-- Exportador Markdown -->
        <div class="win95-container p-3 shadow-[4px_4px_0px_0px_#0A0A0A]">
          <div class="win95-titlebar text-xs mb-2">
            <span id="md-filename-label">GENERADOR_OUTPUT // 009.MD</span>
            <span class="text-[9px]">UTF-8</span>
          </div>
          <div class="bg-[#0A0A0A] p-3 text-[var(--verde-acido)] font-mono-tech text-[11px] overflow-x-auto max-h-40 scrollbar-thin">
            <pre id="output-markdown" class="whitespace-pre"></pre>
          </div>
          <div class="mt-3 flex flex-wrap justify-between items-center gap-2">
            <span id="md-copied-toast" class="font-mono-tech text-xs text-[var(--rojo)] font-bold opacity-0 transition-opacity duration-75">¡COPIADO AL PORTAPAPELES!</span>
            <div class="flex gap-2">
              <button id="btn-copy-md" class="win95-btn font-bold text-xs">
                [ COPIAR TEXTO ]
              </button>
              <button id="btn-download-md" class="win95-btn font-bold text-xs">
                [ DESCARGAR .MD ]
              </button>
            </div>
          </div>
        </div>

        <!-- Exportador Instagram Caption -->
        <div class="win95-container p-3 shadow-[4px_4px_0px_0px_#0A0A0A]">
          <div class="win95-titlebar text-xs mb-2">
            <span>INSTAGRAM_CAPTION // YUX_OFFICIAL</span>
            <span class="text-[9px]">META-FORMAT</span>
          </div>
          <div class="bg-white p-3 text-[#111] font-mono-tech text-[11px] border border-[#888] overflow-x-auto max-h-36 scrollbar-thin">
            <pre id="output-caption" class="whitespace-pre-wrap font-mono-tech"></pre>
          </div>
          <div class="mt-3 flex justify-between items-center">
            <span id="caption-copied-toast" class="font-mono-tech text-xs text-[var(--rojo)] font-bold opacity-0 transition-opacity duration-75">¡CAPTION COPIADO!</span>
            <button id="btn-copy-caption" class="win95-btn font-bold text-xs">
              [ COPIAR CAPTION ]
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- PESTAÑA 02: GESTOR DE ARCHIVOS (.MD + .JPG) -->
    <div id="tab-content-files" class="hidden space-y-6">
      <div class="bg-[var(--hueso)] border-2 border-[var(--negro)] p-6 shadow-[4px_4px_0px_0px_#0A0A0A]">
        <div class="border-b-2 border-[var(--negro)] pb-3 mb-6 flex justify-between items-center">
          <div>
            <h3 class="font-display text-2xl uppercase tracking-tighter">SUBIDA Y PREPARACIÓN DE RECURSOS</h3>
            <p class="font-mono-tech text-xs text-[#555]">Carga la imagen de la pieza para previsualizarla y preparar los archivos para el repositorio.</p>
          </div>
          <span class="font-mono-tech text-xs bg-[var(--rojo)] text-white px-2 py-0.5 font-bold">PIPELINE ACTIVO</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
          <!-- Dropzone de Imagen -->
          <div class="border-2 border-dashed border-[var(--negro)] p-6 bg-[#FAFAFA] text-center flex flex-col items-center justify-center min-h-[260px] relative cursor-pointer hover:bg-[#F0F0F0] transition-colors duration-75">
            <input type="file" id="image-file-input" accept="image/jpeg,image/png,image/webp" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full" />
            <div class="w-12 h-12 bg-[var(--negro)] text-[var(--hueso)] flex items-center justify-center font-bold text-xl mb-3">
              +
            </div>
            <p class="font-mono-tech text-xs font-bold uppercase mb-1">
              ARRASTRA AQUÍ LA IMAGEN FUENTE O HAZ CLICK
            </p>
            <p class="font-mono-tech text-[10px] text-[#777] mb-3">
              FORMATOS PERMITIDOS: JPEG, PNG, WEBP // LADO LARGO MÁX: ~1300PX
            </p>
            <div id="file-info-badge" class="font-mono-tech text-[10px] bg-[var(--concreto)] text-[var(--negro)] px-2 py-1 font-bold">
              SIN ARCHIVO SELECCIONADO
            </div>
          </div>

          <!-- Acciones de Publicación -->
          <div class="win95-container p-4 space-y-4">
            <div class="win95-titlebar text-xs">
              <span>ACCIONES_EXPEDIENTE // INSTRUCCIONES</span>
            </div>
            <div class="font-mono-tech text-xs text-[#222] space-y-2 leading-relaxed">
              <p class="font-bold text-[var(--rojo)]">CÓMO PUBLICAR ESTA PIEZA EN PRODUCCIÓN:</p>
              <ol class="list-decimal pl-5 space-y-1 text-[11px]">
                <li><b>Opción A (Recomendada - Directa):</b> Abre el <b><a href="/admin" target="_blank" class="underline font-bold text-[var(--rojo)]">Panel Decap CMS</a></b>. Al estar autenticado en GitHub/Netlify, puedes rellenar estos campos y subir la imagen directamente desde el navegador haciendo el commit automático.</li>
                <li><b>Opción B (Local / Git Manual):</b>
                  <div class="mt-2 flex flex-col gap-2">
                    <button id="btn-bundle-md" class="win95-btn text-[11px] font-bold text-left">
                      💾 1. Descargar archivo <span id="download-md-label">009.md</span> → colocar en <code class="bg-[#eee] px-1">src/content/piezas/</code>
                    </button>
                    <button id="btn-bundle-img" class="win95-btn text-[11px] font-bold text-left" disabled>
                      🖼️ 2. Descargar imagen <span id="download-img-label">009.jpg</span> → colocar en <code class="bg-[#eee] px-1">src/assets/</code>
                    </button>
                  </div>
                </li>
              </ol>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- PESTAÑA 03: EXPEDIENTES EXISTENTES -->
    <div id="tab-content-catalog" class="hidden space-y-4">
      <div class="bg-[var(--hueso)] border-2 border-[var(--negro)] p-6 shadow-[4px_4px_0px_0px_#0A0A0A]">
        <div class="border-b-2 border-[var(--negro)] pb-3 mb-4 flex justify-between items-center">
          <h3 class="font-display text-2xl uppercase tracking-tighter">CATÁLOGO CENTRAL EN MEMORIA</h3>
          <span class="font-mono-tech text-xs text-[#666]">SELECCIONA UN EXPEDIENTE PARA CARGAR SUS PARÁMETROS</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 font-mono-tech text-xs">
          {existingPieces.map((p) => (
            <div class="border border-[var(--negro)] bg-white p-3 flex flex-col justify-between hover:shadow-[3px_3px_0px_0px_#0A0A0A] transition-shadow duration-75">
              <div>
                <div class="flex justify-between items-center text-[10px] mb-1">
                  <span class="font-bold">#{p.data.code}</span>
                  <span class="w-2.5 h-2.5 border border-black" style={`background-color: ${p.data.accent_color};`}></span>
                </div>
                <p class="font-display text-base tracking-tight leading-tight mb-1 text-[var(--negro)]">
                  {p.data.title}
                </p>
                <p class="text-[10px] text-[#666] truncate mb-2">
                  {p.data.subject}
                </p>
              </div>
              <button 
                class="win95-btn text-[10px] font-bold text-center w-full btn-load-piece"
                data-piece={JSON.stringify(p.data)}
              >
                [ CARGAR EN EDITOR ]
              </button>
            </div>
          ))}
        </div>
      </div>
