                />

                <div class="flex flex-wrap gap-2 pt-2">
                  <button id="btn-save-webhook" class="win95-btn font-bold text-xs">
                    [ GUARDAR CONEXIÓN ]
                  </button>
                  <button id="btn-test-webhook" class="win95-btn text-xs">
                    [ ENVIAR TRANSMISIÓN DE PRUEBA ]
                  </button>
                </div>
                <div id="webhook-toast" class="hidden font-bold text-[10px] p-2 bg-[#0A0A0A] text-[var(--verde-acido)] border border-[var(--verde-acido)]"></div>
