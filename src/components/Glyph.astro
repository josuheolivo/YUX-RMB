---
const { class: className } = Astro.props;
---
<svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" class={className}>
  <!-- YUX RMB — sello / glyph del movimiento -->
  <!-- Marco cuadrado -->
  <rect x="15" y="15" width="170" height="170" fill="none" stroke="#0A0A0A" stroke-width="3"/>

  <!-- Miras/crosshair en las 4 esquinas -->
  <g fill="#0A0A0A">
    <rect x="8" y="14" width="14" height="2"/>
    <rect x="14" y="8" width="2" height="14"/>

    <rect x="178" y="14" width="14" height="2"/>
    <rect x="184" y="8" width="2" height="14"/>

    <rect x="8" y="184" width="14" height="2"/>
    <rect x="14" y="178" width="2" height="14"/>

    <rect x="178" y="184" width="14" height="2"/>
    <rect x="184" y="178" width="2" height="14"/>
  </g>

  <!-- Letra Y central, cortada por una barra de glitch -->
  <text x="100" y="132" font-family="Arial, Helvetica, sans-serif" font-weight="900"
        font-size="110" text-anchor="middle" fill="#0A0A0A">Y</text>

  <!-- Barra de corte / glitch -->
  <rect x="15" y="93" width="170" height="9" fill="#F0EDE6"/>
  <rect x="15" y="93" width="170" height="9" fill="none" stroke="#C41E1E" stroke-width="2"/>
  <rect x="60" y="93" width="30" height="9" fill="#C41E1E"/>

  <!-- Dos eslabones de cadena en la base -->
  <ellipse cx="72" cy="163" rx="11" ry="15" fill="none" stroke="#0A0A0A" stroke-width="4"/>
  <ellipse cx="96" cy="163" rx="11" ry="15" fill="none" stroke="#0A0A0A" stroke-width="4"/>

  <!-- Texto pequeño RMB debajo, estilo ficha técnica -->
  <text x="100" y="30" font-family="Courier New, monospace" font-weight="700"
        font-size="12" text-anchor="middle" letter-spacing="2" fill="#0A0A0A">RMB</text>
</svg>
