---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Archivo forense de Retromaximalismo Bruto (RMB). Tensión sin resolver entre brutalismo, maximalismo y retrofuturismo por Josuhe." />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — YUX // RMB Archive</title>

    <!-- Metadatos de Redes Sociales (Open Graph / Twitter) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="YUX // RMB Archive" />
    <meta property="og:title" content={`${title} — YUX // RMB Archive`} />
    <meta property="og:description" content="Archivo forense de Retromaximalismo Bruto (RMB). Tensión sin resolver entre brutalismo, maximalismo y retrofuturismo por Josuhe." />
    <meta property="og:image" content="https://yux-rmb.netlify.app/assets/wallpapers/001.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — YUX // RMB Archive`} />
    <meta name="twitter:description" content="Archivo forense de Retromaximalismo Bruto (RMB). Tensión sin resolver entre brutalismo, maximalismo y retrofuturismo por Josuhe." />
    <meta name="twitter:image" content="https://yux-rmb.netlify.app/assets/wallpapers/001.jpg" />
    <meta name="theme-color" content="#0A0A0A" />

    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  </head>
  <body class="bg-[var(--hueso)] text-[var(--negro)] font-body-manifesto min-h-screen">
    <main class="max-w-7xl mx-auto p-4 sm:p-8">
      <slot />
    </main>
    <script is:inline>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on("init", user => {
          if (!user) {
            window.netlifyIdentity.on("login", () => {
              document.location.href = "/admin/";
            });
          }
        });

        // Asegurar apertura del modal si el usuario llega con token de invitación o recuperación
        if (window.location.hash && (window.location.hash.includes('invite_token=') || window.location.hash.includes('recovery_token='))) {
          window.netlifyIdentity.on("init", () => {
            window.netlifyIdentity.open();
          });
        }
      }
    </script>
  </body>
</html>
